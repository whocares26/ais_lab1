{
  "domain": "Интерпретация результатов измерения характеристик сетевого канала",

  "goal_objects": ["причина", "рекомендация"],

  "objects": {
    "потери": {
      "prompt": "Доля потерянных пакетов? (нет: 0%, единичные: до 0.1%, значительные: свыше 1%)",
      "values": ["нет", "единичные", "значительные"],
      "multi": false
    },
    "тип_потерь": {
      "prompt": "Характер потерь? (пакетные: теряются подряд идущие пакеты, равномерные: распределены по всему тесту)",
      "values": ["пакетные", "равномерные"],
      "multi": false
    },
    "джиттер": {
      "prompt": "Джиттер? (низкий: до 5 мс, высокий: свыше 5 мс)",
      "values": ["низкий", "высокий"],
      "multi": false
    },
    "разрыв_p99_p50": {
      "prompt": "Разрыв между 99-м и 50-м процентилями задержки? (малый: менее чем в 2 раза, большой: свыше 3 раз)",
      "values": ["малый", "большой"],
      "multi": false
    },
    "задержка_средняя": {
      "prompt": "Средняя задержка? (низкая: до 30 мс, высокая: свыше 100 мс)",
      "values": ["низкая", "высокая"],
      "multi": false
    },
    "переупорядочивание": {
      "prompt": "Зафиксировано ли переупорядочивание пакетов?",
      "values": ["есть", "нет"],
      "multi": false
    },
    "дубликаты": {
      "prompt": "Зафиксированы ли дубликаты пакетов?",
      "values": ["есть", "нет"],
      "multi": false
    },
    "зависимость_задержки_от_нагрузки": {
      "prompt": "Растёт ли задержка при увеличении интенсивности нагрузки?",
      "values": ["да", "нет"],
      "multi": false
    },
    "протокол": {
      "prompt": "Протокол тестирования?",
      "values": ["tcp", "udp"],
      "multi": false
    },
    "модель_нагрузки": {
      "prompt": "Модель нагрузки? (закрытая: фиксированное число соединений, открытая: заданная интенсивность)",
      "values": ["закрытая", "открытая"],
      "multi": false
    },
    "загрузка_cpu_генератора": {
      "prompt": "Загрузка процессора на узле генератора нагрузки? (низкая: до 70%, высокая: свыше 90%)",
      "values": ["низкая", "высокая"],
      "multi": false
    },
    "эталонный_приёмник": {
      "prompt": "Использовался ли эталонный приёмник на узле назначения?",
      "values": ["использовался", "не_использовался"],
      "multi": false
    },
    "требуется_задержка": {
      "prompt": "Требуется ли по условиям тестирования измерить задержку?",
      "values": ["да", "нет"],
      "multi": false
    },

    "состояние_канала": {
      "values": ["стабильный", "перегружен", "нестабильный"],
      "multi": false
    },
    "характер_задержки": {
      "values": ["растущая_под_нагрузкой", "постоянная"],
      "multi": false
    },
    "признак_мультипутевости": {
      "values": ["да"],
      "multi": false
    },
    "достоверность": {
      "values": ["подтверждённая", "сомнительная"],
      "multi": false
    },
    "измерение": {
      "values": ["невыполнимо"],
      "multi": false
    },
    "причина": {
      "values": [
        "перегрузка_канала",
        "балансировка_по_нескольким_маршрутам",
        "географическая_удалённость",
        "беспроводной_участок_или_помехи",
        "накопление_очередей"
      ],
      "multi": true
    },
    "рекомендация": {
      "values": [
        "снизить_интенсивность_и_повторить",
        "снизить_интенсивность_или_расширить_канал",
        "учитывать_переупорядочивание_в_протоколе",
        "разместить_генератор_ближе_к_цели",
        "повторить_измерение_по_проводному_каналу",
        "запустить_тест_с_эталонным_приёмником"
      ],
      "multi": true
    }
  },

  "initial_facts": {
    "потери": "нет",
    "разрыв_p99_p50": "большой",
    "протокол": "udp",
    "модель_нагрузки": "открытая",
    "эталонный_приёмник": "использовался"
  },

  "rules": [
    {
      "id": 1,
      "if": [
        { "object": "потери", "value": "нет" },
        { "object": "джиттер", "value": "низкий" },
        { "object": "разрыв_p99_p50", "value": "малый" }
      ],
      "then": { "object": "состояние_канала", "value": "стабильный" }
    },
    {
      "id": 2,
      "if": [
        { "object": "потери", "value": "значительные" },
        { "object": "зависимость_задержки_от_нагрузки", "value": "да" }
      ],
      "then": { "object": "состояние_канала", "value": "перегружен" }
    },
    {
      "id": 3,
      "if": [
        { "object": "джиттер", "value": "высокий" },
        { "object": "потери", "value": "единичные" }
      ],
      "then": { "object": "состояние_канала", "value": "нестабильный" }
    },
    {
      "id": 4,
      "if": [
        { "object": "разрыв_p99_p50", "value": "большой" },
        { "object": "зависимость_задержки_от_нагрузки", "value": "да" }
      ],
      "then": { "object": "характер_задержки", "value": "растущая_под_нагрузкой" }
    },
    {
      "id": 5,
      "if": [
        { "object": "разрыв_p99_p50", "value": "малый" },
        { "object": "задержка_средняя", "value": "высокая" }
      ],
      "then": { "object": "характер_задержки", "value": "постоянная" }
    },
    {
      "id": 6,
      "if": [
        { "object": "переупорядочивание", "value": "есть" },
        { "object": "дубликаты", "value": "есть" },
        { "object": "потери", "value": "нет" }
      ],
      "then": { "object": "признак_мультипутевости", "value": "да" }
    },

    {
      "id": 7,
      "if": [
        { "object": "состояние_канала", "value": "перегружен" },
        { "object": "тип_потерь", "value": "пакетные" }
      ],
      "then": { "object": "причина", "value": "перегрузка_канала" }
    },
    {
      "id": 8,
      "if": [
        { "object": "признак_мультипутевости", "value": "да" }
      ],
      "then": { "object": "причина", "value": "балансировка_по_нескольким_маршрутам" }
    },
    {
      "id": 9,
      "if": [
        { "object": "характер_задержки", "value": "постоянная" },
        { "object": "потери", "value": "нет" }
      ],
      "then": { "object": "причина", "value": "географическая_удалённость" }
    },
    {
      "id": 10,
      "if": [
        { "object": "состояние_канала", "value": "нестабильный" },
        { "object": "протокол", "value": "udp" }
      ],
      "then": { "object": "причина", "value": "беспроводной_участок_или_помехи" }
    },
    {
      "id": 11,
      "if": [
        { "object": "характер_задержки", "value": "растущая_под_нагрузкой" },
        { "object": "тип_потерь", "value": "равномерные" }
      ],
      "then": { "object": "причина", "value": "накопление_очередей" }
    },

    {
      "id": 12,
      "if": [
        { "object": "модель_нагрузки", "value": "открытая" },
        { "object": "загрузка_cpu_генератора", "value": "высокая" }
      ],
      "then": { "object": "достоверность", "value": "сомнительная" }
    },
    {
      "id": 13,
      "if": [
        { "object": "модель_нагрузки", "value": "открытая" },
        { "object": "загрузка_cpu_генератора", "value": "низкая" }
      ],
      "then": { "object": "достоверность", "value": "подтверждённая" }
    },
    {
      "id": 14,
      "if": [
        { "object": "эталонный_приёмник", "value": "не_использовался" },
        { "object": "требуется_задержка", "value": "да" }
      ],
      "then": { "object": "измерение", "value": "невыполнимо" }
    },

    {
      "id": 15,
      "if": [
        { "object": "достоверность", "value": "сомнительная" }
      ],
      "then": { "object": "рекомендация", "value": "снизить_интенсивность_и_повторить" }
    },
    {
      "id": 16,
      "if": [
        { "object": "причина", "value": "перегрузка_канала" }
      ],
      "then": { "object": "рекомендация", "value": "снизить_интенсивность_или_расширить_канал" }
    },
    {
      "id": 17,
      "if": [
        { "object": "причина", "value": "балансировка_по_нескольким_маршрутам" },
        { "object": "протокол", "value": "udp" }
      ],
      "then": { "object": "рекомендация", "value": "учитывать_переупорядочивание_в_протоколе" }
    },
    {
      "id": 18,
      "if": [
        { "object": "причина", "value": "географическая_удалённость" }
      ],
      "then": { "object": "рекомендация", "value": "разместить_генератор_ближе_к_цели" }
    },
    {
      "id": 19,
      "if": [
        { "object": "причина", "value": "беспроводной_участок_или_помехи" }
      ],
      "then": { "object": "рекомендация", "value": "повторить_измерение_по_проводному_каналу" }
    },
    {
      "id": 20,
      "if": [
        { "object": "измерение", "value": "невыполнимо" }
      ],
      "then": { "object": "рекомендация", "value": "запустить_тест_с_эталонным_приёмником" }
    }
  ]
}